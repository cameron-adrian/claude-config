{
  "enableWorkflows": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoCompactWindow": 500000,
  "extraKnownMarketplaces": {
    "cameron-house": {
      "source": {
        "source": "github",
        "repo": "cameron-adrian/claude-config"
      }
    }
  },
  "enabledPlugins": {
    "house@cameron-house": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"C:/Users/Cameron/claude-config\" pull --ff-only --quiet 2>/dev/null || true",
            "async": true,
            "timeout": 20,
            "statusMessage": "Syncing global CLAUDE.md"
          }
        ]
      }
    ]
  }
}
