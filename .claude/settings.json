{
  "extraKnownMarketplaces": {
    "cameron-house": {
      "source": {
        "source": "github",
        "repo": "cameron-adrian/claude-config"
      }
    }
  },
  "enabledPlugins": {
    "house@cameron-house": true
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset)",
      "Bash(git reset *)",
      "Bash(git rm *)",
      "Bash(git restore *)",
      "Bash(git worktree *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ]
  }
}
